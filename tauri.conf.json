{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitEagle",
  "mainBinaryName": "giteagle",
  "version": "0.1.0",
  "identifier": "net.diath.giteagle",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "ui" }
  },
  "app": {
    "windows": [
      {
        "title": "GitEagle",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 750,
        "backgroundColor": "#141210"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Git repository viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
